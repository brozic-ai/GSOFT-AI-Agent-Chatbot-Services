# Copy thành .env và điền giá trị thật. Giá trị dưới đây là default trong app/core/config.py
# (nguồn chân lý duy nhất — nếu thấy lệch, sửa theo config.py, không sửa theo file này).

# --- Core Application ---
ENVIRONMENT=local
PROJECT_NAME="Chatbot BVBank AI Service"
API_V1_STR=/api/v1
# Rỗng = tắt xác thực API key nội bộ (chỉ dùng cho dev)
REQUIRED_API_KEY=
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:4200

# --- Database (SQL Server 2025, ODBC Driver 18) ---
SQLSERVER_CONNECTIONSTRING="Driver={ODBC Driver 18 for SQL Server};Server=LAPTOP-BE44K422\MSSQLSERVER01;Database=gAMSPro_BVB_AI_V1_LIVE_04082026_1;Trusted_Connection=yes;TrustServerCertificate=yes;"

# --- AI Provider ---
# Lựa chọn: vllm | gemini | openai_compat
AI_PROVIDER=vllm
FALLBACK_AI_PROVIDER=
TEST_PROVIDER=vllm

# --- Local / vLLM / Ollama (OpenAI-compatible API) ---
LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=http://localhost:11434/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_API_KEY=ollama

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- OpenAI-compatible ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Embedding ---
TEI_URL=http://localhost:8080
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMS=1024
ENABLE_LOCAL_EMBEDDING_FALLBACK=False

# --- Search / Hybrid RRF ---
SEARCH_CHAT_TOP_K=5
SEARCH_TOP_K_MAX=50
SEARCH_VECTOR_CANDIDATE_COUNT=200
SEARCH_RRF_CONSTANT=60
HYBRID_TOP_K_CANDIDATES=20

# --- Full-Text Search (FTS) ---
# Bật/tắt Full-Text Search; False = fallback về Vector-only search.
FTS_ENABLED=True
FTS_MAX_CANDIDATES=200
# Trọng số hai luồng trong RRF (tổng khuyến nghị = 1.0)
RRF_VECTOR_WEIGHT=0.6
RRF_FTS_WEIGHT=0.4

# --- Ingestion (chunking / OCR) ---
INGESTION_ENABLE_OCR=True
INGESTION_TESSDATA_PATH=tessdata
INGESTION_ENABLE_VISION_OCR=False
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_CHUNK_BY_TOKENS=True
RAG_MIN_SLIDE_CHARS=200
RAG_MAX_SLIDE_CHARS=2000

# --- Reranker ---
RERANKER_TYPE=bge
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TOP_K=4
RERANKER_SCORE_THRESHOLD=0.35

# --- FAQ Agent ---
FAQ_SEARCH_CANDIDATES_K=10
FAQ_RERANKER_TOP_K=3
FAQ_FAST_MATCH_ENABLED=True
FAQ_FAST_MATCH_THRESHOLD=0.80

# --- Chat ---
CHAT_HISTORY_LIMIT=10

# --- RAG Dynamic Top-K (Min 3, Max 15) ---
RAG_DYNAMIC_TOP_K_ENABLED=True
RAG_MIN_TOP_K=3
RAG_MAX_TOP_K=15
RAG_DEFAULT_TOP_K=5
RAG_SPECIFIC_TOP_K=3
RAG_EXHAUSTIVE_TOP_K=12
RAG_CANDIDATE_MULTIPLIER=3

# --- RAG Preprocessing & Context Builder ---
RAG_ENABLE_VIETNAMESE_NORMALIZATION=True
RAG_ENABLE_MARKDOWN_CONVERSION=True
RAG_CONTEXT_MAX_CHARS=18000
RAG_CONTEXT_GENERAL_CHUNK_MAX_CHARS=2000
RAG_CONTEXT_PROCEDURE_CHUNK_MAX_CHARS=5000
RAG_CONTEXT_IMAGE_CHUNK_MAX_CHARS=1500
RAG_CONTEXT_NEAR_DUP_LINE_OVERLAP=0.85
RAG_DYNAMIC_MAX_TOKENS_ENABLED=True

# --- Langfuse Tracing (LangSmith đã bị tắt cứng trong config.py, không dùng nữa) ---
LANGFUSE_ENABLED=True
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_BASE_URL=

# --- Net Backend (gAMSPro ASP.NET gateway) ---
NET_BACKEND_URL=http://localhost:5000
